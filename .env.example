
# ==========================================
# LLM / Infron API Ayarları
# ==========================================
LLM_BASE_URL=https://llm.onerouter.pro/v1
INFRON_API_KEY=your_infron_api_key_here
LLM_MODEL=deepseek/deepseek-v4-flash:free
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=0

# ==========================================
# GitHub Ayarları
# ==========================================
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_WEBHOOK_SECRET=your_webhook_secret_string
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=your_repo_name

# ==========================================
# Docker / Sandbox Ayarları
# ==========================================
SANDBOX_IMAGE=code-reviewer-sandbox:latest
SANDBOX_TIMEOUT=30

# ==========================================
# Uygulama Ayarları
# ==========================================
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
